datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. User (Owner Details)
model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  mobile          String    @unique
  email           String    @unique
  password        String
  status          String    @default("ACTIVE")        // ACTIVE, INACTIVE, SUSPENDED
  lastLogin       DateTime? @map("last_login")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  address         String?
  companyName     String?   @map("company_name")
  secondaryMobile String?   @map("secondary_mobile")
  city            String?   @map("city")
  education       String?   @map("education")
  profileImage    String?   @map("profile_image")

  documents       OwnerDocument[]

  @@map("users")
}

// 1b. Owner Documents Drive Vault
model OwnerDocument {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @map("user_id") @db.ObjectId
  title           String
  category        String    // RC_BOOK, INSURANCE, PERMIT, ID_PROOF, TAX, CONTRACT, OTHER
  fileUrl         String    @map("file_url")
  fileName        String    @map("file_name")
  fileSize        String?   @map("file_size")
  fileType        String?   @map("file_type")
  createdAt       DateTime  @default(now())           @map("created_at")

  user            User      @relation(fields: [userId], references: [id])

  @@map("owner_documents")
}

// 2. Class Machine Bills
model ClassBill {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  date            DateTime  @default(now())
  place           String
  customerName    String    @map("customer_name")
  contactNumber   String    @map("contact_number")
  timeHours       Float     @map("time_hours")
  totalAmount     Float     @map("total_amount")
  advance         Float
  balance         Float
  remarks         String?
  status          Int       @default(0)               // 0 = PENDING, 1 = COMPLETED
  createdAt       DateTime  @default(now()) @map("created_at")

  payments        ClassBillPayment[]

  @@map("class_bills")
}

model ClassBillPayment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  billId          String    @map("bill_id") @db.ObjectId
  amount          Float
  paymentDate     DateTime  @default(now()) @map("payment_date")
  remarks         String?

  bill            ClassBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("class_bill_payments")
}

// 3. Kartar Machine Bills
model KartarBill {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  date            DateTime  @default(now())
  place           String
  customerName    String    @map("customer_name")
  contactNumber   String    @map("contact_number")
  timeHours       Float     @map("time_hours")
  totalAmount     Float     @map("total_amount")
  advance         Float
  balance         Float
  remarks         String?
  status          Int       @default(0)               // 0 = PENDING, 1 = COMPLETED
  createdAt       DateTime  @default(now()) @map("created_at")

  payments        KartarBillPayment[]

  @@map("kartar_bills")
}

model KartarBillPayment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  billId          String    @map("bill_id") @db.ObjectId
  amount          Float
  paymentDate     DateTime  @default(now()) @map("payment_date")
  remarks         String?

  bill            KartarBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("kartar_bill_payments")
}

// 5. Operator Records Module
model Operator {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  operatorName    String    @map("operator_name")
  mobile          String
  salary          Float
  createdAt       DateTime  @default(now()) @map("created_at")

  attendances     OperatorAttendance[]
  payments        OperatorSalaryPayment[]

  @@map("operators")
}

model OperatorAttendance {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  operatorId      String    @map("operator_id") @db.ObjectId
  date            DateTime  @default(now())
  status          String                              // PRESENT, ABSENT
  dailyWage       Float?    @map("daily_wage")

  operator        Operator  @relation(fields: [operatorId], references: [id])

  @@map("operator_attendances")
}

model OperatorSalaryPayment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  operatorId      String    @map("operator_id") @db.ObjectId
  amount          Float
  paymentDate     DateTime  @default(now()) @map("payment_date")
  remarks         String?

  operator        Operator  @relation(fields: [operatorId], references: [id])

  @@map("operator_salary_payments")
}

// 6. Bunk Details Module
model BunkDetail {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  date            DateTime  @default(now())
  fuelAmount      Float     @map("fuel_amount")
  paidAmount      Float     @default(0)               @map("paid_amount")
  balance         Float     @default(0)               @map("balance")
  paymentStatus   String    @default("PAID")          @map("payment_status")   // PAID, PENDING
  purchasesJson   String?   @map("purchases_json")    // JSON array of itemized purchases
  paymentsJson    String?   @map("payments_json")     // JSON array of itemized payments
  remarks         String?
  createdAt       DateTime  @default(now())           @map("created_at")

  @@map("bunk_details")
}

// 7. Push Notifications Models
model UserDevice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  deviceId    String   @map("device_id")
  fcmToken    String   @map("fcm_token")
  platform    String   @default("android")
  isActive    Boolean  @default(true) @map("is_active")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model NotificationMaster {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  code         String   @unique
  title        String
  message      String
  targetTime   String   @map("target_time") // e.g. "06:00", "09:00", "11:00", "13:00", "17:00", "18:00", "20:30", "21:00"
  category     String   // "GREETING", "HEALTHY_HABIT", "ACTION_REQUIRED"
  targetScreen String   @default("DashboardTab") @map("target_screen")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("notification_master")
}

model NotificationLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String?  @map("user_id") @db.ObjectId
  operatorId       String?  @map("operator_id") @db.ObjectId
  notificationCode String   @map("notification_code")
  notificationDate String   @map("notification_date") // "YYYY-MM-DD" in Asia/Kolkata
  status           String   @default("SENT")          // "SENT", "FAILED"
  sentAt           DateTime @default(now())           @map("sent_at")

  @@unique([userId, notificationCode, notificationDate])
  @@map("notification_logs")
}

