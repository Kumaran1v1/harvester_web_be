{
  "name": "harvester-management-system-backend",
  "version": "1.0.0",
  "description": "Backend API for Harvester Management System",
  "main": "src/dist/index.js",
  "scripts": {
    "dev": "node scripts/start-mongo-rs.js && npx prisma db push --skip-generate && npx prisma db seed && nodemon src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "npx prisma db push --skip-generate && node src/dist/index.js",
    "db:reset": "npx prisma db push --force-reset --skip-generate && npx prisma db seed",
    "mongo:rs": "node scripts/start-mongo-rs.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "socket.io": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "prisma": "^5.12.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
