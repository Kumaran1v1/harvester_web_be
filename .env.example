# Server
PORT=5000
NODE_ENV=development

# Database (Prisma + MongoDB)
# Prisma requires MongoDB to run as a replica set for write operations.
# Local example (single-node replica set on port 27018):
DATABASE_URL="mongodb://127.0.0.1:27018/harvester_db?replicaSet=rs0&directConnection=true"
# Or MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/harvester_db"

# JWT
JWT_SECRET=<your_jwt_secret_key>
JWT_EXPIRATION=24h
